import init.monterey.usb.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug

    write /proc/sys/kernel/sched_boost 1

on init
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    write /dev/stune/foreground/schedtune.sched_boost_no_override 1
    write /dev/stune/top-app/schedtune.sched_boost_no_override 1
    write /dev/stune/schedtune.colocate 0
    write /dev/stune/background/schedtune.colocate 0
    write /dev/stune/system-background/schedtune.colocate 0
    write /dev/stune/foreground/schedtune.colocate 0
    write /dev/stune/top-app/schedtune.colocate 1

    write /sys/block/sda/queue/iostats 0
    write /sys/block/sda/queue/iosched/slice_idle 0
    write /sys/block/sda/queue/read_ahead_kb 2048
    write /sys/block/sda/queue/nr_requests 256
    write /sys/block/dm-0/queue/read_ahead_kb 2048
    write /sys/block/dm-1/queue/read_ahead_kb 2048

    # Disable thermal hotplug
    write /sys/module/msm_thermal/core_control/enabled 0

    # Online all cores
    write /sys/devices/system/cpu/cpu0/online 1
    write /sys/devices/system/cpu/cpu4/online 1

    # create compositor cpuset for high priority processes
    mkdir /dev/cpuset/compositor
    copy /dev/cpuset/cpus /dev/cpuset/compositor/cpus
    copy /dev/cpuset/mems /dev/cpuset/compositor/mems

    chown system system /dev/cpuset/compositor
    chown system system /dev/cpuset/compositor/tasks
    chmod 0664 /dev/cpuset/compositor/tasks

    # Set the cpusets early to boost boot time and adjust back after boot complete
    write /dev/cpuset/top-app/cpus 5-7
    write /dev/cpuset/foreground/cpus 0-3,5-7
    write /dev/cpuset/foreground/boost/cpus 0-3,5-7
    write /dev/cpuset/background/cpus 0-7
    write /dev/cpuset/system-background/cpus 0-7

    write /sys/module/qpnp_rtc/parameters/poweron_alarm 1

    # vold needs keymaster that needs qseecomd
    start vendor.qseecomd
    start vendor.keymaster-3-0

    # Change permissions for Syncboss nodes
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/cpu_affinity
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/enable_data_headers
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/minimum_time_between_transactions_us
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/next_avail_seq_num
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/num_rejected_transactions
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/poll_prio
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/power
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/reset
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/spi_max_clk_rate
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/stats
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/streaming
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/te_timestamp
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/transaction_length
    chown system system /sys/devices/virtual/misc/syncboss0/spi/control/transaction_period_us
    chown system system /sys/devices/virtual/misc/syncboss0/swd/update_firmware

    chown system system /sys/devices/soc/c170000.uart/clock
    chown system system /sys/devices/soc/c170000.uart/power/control

    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/cpu_affinity
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/enable_data_headers
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/minimum_time_between_transactions_us
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/next_avail_seq_num
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/num_rejected_transactions
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/poll_prio
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/power
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/reset
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/spi_max_clk_rate
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/stats
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/streaming
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/te_timestamp
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/transaction_length
    chmod 664 /sys/devices/virtual/misc/syncboss0/spi/control/transaction_period_us
    chmod 664 /sys/devices/virtual/misc/syncboss0/swd/update_firmware

    chmod 664 /sys/devices/soc/c170000.uart/clock
    chmod 664 /sys/devices/soc/c170000.uart/power/control

    # Set cpu affinity for kthreads contributing to tracking (eg syncboss, spi).
    write /sys/devices/virtual/misc/syncboss0/spi/control/cpu_affinity 0f

on fs
    mount_all fstab.${ro.hardware} --early

    restorecon_recursive /vision

    # Create persist folders once /persist is mounted
    mkdir /persist/alarm 0770 system system
    mkdir /persist/battery 0770 root system
    mkdir /persist/bluetooth 0770 bluetooth bluetooth
    mkdir /persist/bms 0700 root system
    mkdir /persist/data 0700 system system
    mkdir /persist/drm 0770 system system
    mkdir /persist/hlos_rfs 0770 system system
    mkdir /persist/misc 0770 system system
    mkdir /persist/rc 0770 root system
    mkdir /persist/rfs 0770 system system
    mkdir /persist/srt_push 0770 root system
    mkdir /persist/time 0770 system system

    restorecon_recursive /persist

    # atrace.rc
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_cmdbatch_queued/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_cmdbatch_submitted/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_cmdbatch_retired/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_cmdbatch_fault/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_cmdbatch_recovery/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_drawctxt_sleep/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_drawctxt_wake/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/dispatch_queue_context/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_drawctxt_invalidate/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_drawctxt_wait_start/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_drawctxt_wait_done/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_drawctxt_switch/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_gpu_fault/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_sp_tp/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_a3xx_irq_status/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_a4xx_irq_status/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_a5xx_irq_status/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_hw_preempt_clear_to_trig/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_hw_preempt_trig_to_comp/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_hw_preempt_trig_to_comp_int/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_hw_preempt_comp_to_clear/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_hw_preempt_token_submit/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_preempt_trigger/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/adreno_preempt_done/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_issueibcmds/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_readtimestamp/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_waittimestamp_entry/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_waittimestamp_exit/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_irq/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_bus/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_rail/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_clk/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_pwrlevel/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_buslevel/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_gpubusy/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_pwrstats/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_pwr_set_state/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_pwr_request_state/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_mem_alloc/enable
    chown root shell /sys/kernel/debug/tracing/events/kgsl/kgsl_mem_mmap/enable
