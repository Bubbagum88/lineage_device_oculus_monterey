    chmod 0664 /sys/kernel/debug/tracing/events/kgsl/sparse_virt_alloc/enable
    chmod 0664 /sys/kernel/debug/tracing/events/kgsl/sparse_phys_free/enable
    chmod 0664 /sys/kernel/debug/tracing/events/kgsl/sparse_virt_free/enable
